---
interface Props {
  lang?: string;
}

const { lang = 'zh-TW' } = Astro.props;

function normalizeLang(langStr: string): 'zh-tw' | 'sc' | 'en' | 'ja' {
  const l = (langStr || '').toLowerCase();
  if (l.includes('en')) return 'en';
  if (l.includes('ja')) return 'ja';
  if (l.includes('sc') || l.includes('hans') || l.includes('cn')) return 'sc';
  return 'zh-tw';
}

const currentLang = normalizeLang(lang);
const prefix = currentLang === 'zh-tw' ? '' : (currentLang === 'sc' ? '/sc' : `/${currentLang}`);
const mainRssUrl = `${prefix}/rss.xml`;

