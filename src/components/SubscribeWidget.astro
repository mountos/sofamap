const current = labels[currentLang];
---

<div class="newsletter-subscription-box">
  <!-- 電子報表單 -->
  <div class="newsletter-card">
    <div class="card-header">
      <h3>{current.formTitle}</h3>
      <p class="card-subtitle">{current.subtitle}</p>
    </div>

    <form id="newsletter-form-sofamap" class="newsletter-form">
      <input type="hidden" name="site" value="sofamap.com" />
      <input type="hidden" name="type" value="newsletter" />
      <input type="hidden" name="lang" value={currentLang} />

      <div class="form-row">
        <div class="form-group">
          <label for="newsletter-email-sofamap">{current.emailLabel}</label>
          <input
            type="email"
            id="newsletter-email-sofamap"
            name="email"
            required
            placeholder={current.emailPlaceholder}
            autocomplete="email"
          />
        </div>
        <div class="form-group">
          <label for="newsletter-name-sofamap">{current.nameLabel}</label>
          <input
            type="text"
            id="newsletter-name-sofamap"
            name="name"
            placeholder={current.namePlaceholder}
            autocomplete="name"
          />
        </div>
      </div>

      <button
        type="submit"
        id="newsletter-submit-btn-sofamap"
        class="subscribe-submit-btn"
        data-submitting={current.submitting}
        data-normal={current.submitBtn}
      >
        {current.submitBtn}
      </button>

      <div
        id="newsletter-response-sofamap"
        class="response-message"
        data-success-msg={current.success}
        data-error-msg={current.error}
      >
      </div>
    </form>
  </div>

  <!-- Chrome Discover / Follow & RSS 訂閱卡片 -->
  <div class="rss-discover-card">
    <div class="rss-header">
      <h3>{current.rssTitle}</h3>
      <p>{current.rssDesc}</p>
    </div>

    <div class="chrome-follow-tip">
      <strong>{current.chromeTipTitle}</strong>
      <p>{current.chromeTipStep}</p>
    </div>

    <div class="rss-main-actions">
      <a href={mainRssUrl} target="_blank" rel="noopener" class="rss-primary-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" />
        </svg>
        <span>{current.rssMainBtn}</span>
      </a>
      <button
        type="button"
        class="rss-copy-btn"
        id="copy-sofamap-rss-btn"
        data-rss-url={`https://sofamap.com${mainRssUrl}`}
        data-normal-label={current.rssCopyBtn}
        data-copied-label={current.rssCopied}
      >
        {current.rssCopyBtn}
      </button>
    </div>
  </div>
</div>

<script>
  function initNewsletterForm() {
    const form = document.getElementById("newsletter-form-sofamap") as HTMLFormElement;
    const responseElem = document.getElementById("newsletter-response-sofamap");
    const submitBtn = document.getElementById("newsletter-submit-btn-sofamap") as HTMLButtonElement;

    if (!form || !submitBtn) return;
    if ((form as any)._initialized) return;
    (form as any)._initialized = true;

    const normalText = submitBtn.dataset.normal || "✉️ 免費訂閱電子報";
    const submittingText = submitBtn.dataset.submitting || "⏳ 處理中...";
    const successMsg = responseElem?.dataset.successMsg || "🎉 感謝您的訂閱！";
    const errorMsg = responseElem?.dataset.errorMsg || "訂閱失敗，請稍後再試。";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = submittingText;
      if (responseElem) responseElem.style.display = "none";

      const formData = new FormData(form);
      const payload: Record<string, any> = Object.fromEntries(formData.entries());

      try {
        const traceRes = await fetch("/cdn-cgi/trace");
        const traceText = await traceRes.text();
        const ipMatch = traceText.match(/ip=(.+)/);
        const locMatch = traceText.match(/loc=(.+)/);
        if (ipMatch) payload.ip = ipMatch[1].trim();
        if (locMatch) payload.country = locMatch[1].trim();

        payload.userAgent = navigator.userAgent;
        payload.language = navigator.language;
        payload.url = window.location.href;
      } catch (err) {}

      try {
        const res = await fetch(
          "https://script.google.com/macros/s/AKfycbzyX_hBo19vRFj5yn3WZqTGk4_gN58Y6g0fQH4IOKnZyJm2tGnCp9inNZt-rk1JssoF/exec",
          {
            method: "POST",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify(payload),
          }
        );
        const result = await res.json();

        if (responseElem) {
          responseElem.style.display = "block";
          if (result.success) {
            responseElem.className = "response-message success";
            responseElem.textContent = successMsg;
            form.reset();
          } else {
            responseElem.className = "response-message error";
            responseElem.textContent = errorMsg;
          }
        }
      } catch (err) {
        if (responseElem) {
          responseElem.style.display = "block";
          responseElem.className = "response-message error";
          responseElem.textContent = errorMsg;
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = normalText;
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initNewsletterForm);
  } else {
    initNewsletterForm();
  }
  document.addEventListener("astro:page-load", initNewsletterForm);

  function initRssCopyBtn() {
    const copyBtn = document.getElementById("copy-sofamap-rss-btn") as HTMLButtonElement | null;
    if (!copyBtn || (copyBtn as any)._initialized) return;
    (copyBtn as any)._initialized = true;
    copyBtn.addEventListener("click", () => {
      const url = copyBtn.dataset.rssUrl || "https://sofamap.com/rss.xml";
      const normal = copyBtn.dataset.normalLabel || "Copy RSS URL";
      const copied = copyBtn.dataset.copiedLabel || "Copied!";
      navigator.clipboard?.writeText(url).then(() => {
        copyBtn.textContent = copied;
        setTimeout(() => {
          copyBtn.textContent = normal;
        }, 2000);
      });
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRssCopyBtn);
  } else {
    initRssCopyBtn();
  }
  document.addEventListener("astro:page-load", initRssCopyBtn);
</script>

<style>
  .newsletter-subscription-box {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: 100%;
    box-sizing: border-box;
  }

  .newsletter-card {
    padding: 2rem;
    background: #ffffff;
    border: 1px solid #fed7aa;
    border-radius: 14px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    text-align: left;
  }

  .card-header h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.3rem;
    font-weight: 700;
    color: #9a3412;
  }

  .card-subtitle {
    margin: 0 0 1.25rem 0;
    font-size: 0.95rem;
    color: #c2410c;
    line-height: 1.55;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
  }

  .form-group label {
    font-size: 0.92rem;
    font-weight: 600;
    color: #9a3412;
  }

  .form-group input {
    padding: 0.75rem 1rem;
    border: 1px solid #fdba74;
    border-radius: 8px;
    font-size: 1rem;
    background: #ffffff;
    color: #1a202c;
    box-sizing: border-box;
    width: 100%;
    transition: all 0.2s ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: #ea580c;
    box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
  }

  .subscribe-submit-btn {
    align-self: flex-start;
    background: #ea580c;
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.85rem 1.75rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .subscribe-submit-btn:hover:not(:disabled) {
    background: #c2410c;
    transform: translateY(-1px);
  }

  .subscribe-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .response-message {
    padding: 0.9rem 1rem;
    border-radius: 8px;
    font-weight: 500;
    display: none;
    text-align: left;
    font-size: 0.95rem;
  }

  .response-message.success {
    background: #f0fff4;
    color: #276749;
    border: 1px solid #9ae6b4;
  }

  .response-message.error {
    background: #fff5f5;
    color: #9b2c2c;
    border: 1px solid #feb2b2;
  }

  /* RSS & Chrome Discover Card */
  .rss-discover-card {
    padding: 1.75rem 2rem;
    background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
    border: 1px solid #fed7aa;
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    text-align: left;
  }

  .rss-header h3 {
    margin: 0 0 0.35rem 0;
    font-size: 1.2rem;
    font-weight: 700;
    color: #9a3412;
  }

  .rss-header p {
    margin: 0;
    font-size: 0.92rem;
    color: #c2410c;
    line-height: 1.5;
  }

  .chrome-follow-tip {
    background: rgba(255, 255, 255, 0.75);
    border-left: 4px solid #ea580c;
    padding: 0.85rem 1.1rem;
    border-radius: 8px;
  }

  .chrome-follow-tip strong {
    display: block;
    font-size: 0.92rem;
    color: #7c2d12;
    margin-bottom: 0.25rem;
  }

  .chrome-follow-tip p {
    margin: 0;
    font-size: 0.86rem;
    color: #9a3412;
    line-height: 1.5;
  }

  .rss-main-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .rss-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ea580c;
    color: #ffffff !important;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.72rem 1.35rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .rss-primary-btn:hover {
    background: #c2410c;
    transform: translateY(-1px);
  }

  .rss-copy-btn {
    background: #ffffff;
    color: #c2410c;
    border: 1px solid #fb923c;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.7rem 1.15rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .rss-copy-btn:hover {
    background: #fed7aa;
  }
</style>
