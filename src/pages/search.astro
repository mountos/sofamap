---
import Layout from '../layouts/Layout.astro';
---

<Layout title="搜尋文章 | Sofamap 沙發地圖">
  <main class="static-page">
    <div id="search" class="search-container"></div>
  </main>
  <style>
    .static-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
    }
  </style>

  <script is:inline>
    function initCustomSearch() {
      const container = document.querySelector("#search");
      if (!container || container._initialized) return;
      container._initialized = true;

      const path = window.location.pathname;
      let currentLang = 'zh-tw';
      if (path.startsWith('/sc/') || path.includes('/sc/')) currentLang = 'sc';
      else if (path.startsWith('/ja/') || path.includes('/ja/')) currentLang = 'ja';
      else if (path.startsWith('/en/') || path.includes('/en/')) currentLang = 'en';

      const t = {
        'zh-tw': { placeholder: "搜尋沙發客、旅行冒險與各國文化體驗...", noResults: "找不到與 \"{query}\" 相關的結果", found: "找到 {count} 篇關於 \"{query}\" 的文章" },
        'sc': { placeholder: "搜索沙发客、旅行冒险与各国文化体验...", noResults: "未找到与 \"{query}\" 相关的结果", found: "找到 {count} 篇关于 \"{query}\" 的文章" },
        'en': { placeholder: "Search couchsurfing, travels, adventures...", noResults: "No results found for \"{query}\"", found: "Found {count} results for \"{query}\"" },
        'ja': { placeholder: "カウチサーフィン、旅行、冒険を検索...", noResults: "\"{query}\" に関する結果が見つかりません", found: "\"{query}\" に関する記事が {count} 件見つかりました" }
      }[currentLang] || { placeholder: "搜尋文章...", noResults: "找不到結果", found: "找到 {count} 篇文章" };

      container.innerHTML = `
        <div class="search-input-wrapper" style="position: relative; margin-bottom: 2rem;">
          <input type="search" id="custom-search-input" placeholder="${t.placeholder}" autocomplete="off" style="width: 100%; padding: 1rem 1.5rem; font-size: 1.05rem; border-radius: 8px; border: 1px solid var(--border, #ccc); background: var(--bg-card, #fff); color: var(--text, #333); box-sizing: border-box; outline: none;">
          <div id="search-status" style="margin-top: 1rem; color: var(--text-muted, #666); text-align: center; font-size: 0.95rem;"></div>
        </div>
        <div id="custom-search-results"></div>
      `;

      const input = document.getElementById('custom-search-input');
      const resultsContainer = document.getElementById('custom-search-results');
      const statusContainer = document.getElementById('search-status');

      let searchIndex = null;
      let isLoading = false;
      let timeoutId = null;

      const loadIndex = async () => {
        if (searchIndex || isLoading) return searchIndex;
        isLoading = true;
        try {
          const res = await fetch('/search-index.json');
          const data = await res.json();
          searchIndex = data.filter(item => {
            const itemLang = (item.lang || 'zh-tw').toLowerCase();
            if (currentLang === 'zh-tw') return itemLang === 'zh-tw' || itemLang === 'zh';
            return itemLang === currentLang;
          });
        } catch (e) {
          console.error("Failed to load search index", e);
        } finally {
          isLoading = false;
          if (input && input.value.trim()) performSearch(input.value.trim());
        }
        return searchIndex;
      };

      const highlight = (text, queryTerms) => {
        if (!text || !queryTerms || queryTerms.length === 0) return text || '';
        let escaped = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        queryTerms.forEach(term => {
          if (!term) return;
          const reg = new RegExp(`(${term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
          escaped = escaped.replace(reg, '<mark style="background: rgba(178, 83, 56, 0.15); color: #b25338; padding: 0 0.2em; border-radius: 3px; font-weight: 600;">$1</mark>');
        });
        return escaped;
      };

      const performSearch = (query) => {
        const trimmed = (query || '').trim();
        const url = new URL(window.location.href);
        if (trimmed) {
          url.searchParams.set('q', trimmed);
        } else {
          url.searchParams.delete('q');
          resultsContainer.innerHTML = '';
          statusContainer.innerHTML = '';
          window.history.replaceState({}, '', url.toString());
          return;
        }
        window.history.replaceState({}, '', url.toString());

        if (!searchIndex) {
          loadIndex();
          return;
        }

        const terms = trimmed.toLowerCase().split(/\s+/).filter(Boolean);
        if (terms.length === 0) return;

        const results = [];
        for (const item of searchIndex) {
          const titleLower = (item.title || '').toLowerCase();
          const descLower = (item.excerpt || item.description || '').toLowerCase();
          const contentLower = (item.content || '').toLowerCase();
          const tagsLower = (item.tags || []).map(t => String(t).toLowerCase());

          let matchAll = true;
          let score = 0;
          for (const t of terms) {
            let matched = false;
            if (titleLower.includes(t)) { matched = true; score += 100; }
            if (tagsLower.some(tag => tag.includes(t))) { matched = true; score += 60; }
            if (descLower.includes(t)) { matched = true; score += 40; }
            if (contentLower.includes(t)) { matched = true; score += 20; }
            if (!matched) matchAll = false;
          }

          if (matchAll && score > 0) {
            results.push({ item, score });
          }
        }

        results.sort((a, b) => b.score - a.score);

        if (results.length === 0) {
          statusContainer.innerHTML = t.noResults.replace('{query}', trimmed.replace(/</g, '&lt;'));
          resultsContainer.innerHTML = '';
          return;
        }

        statusContainer.innerHTML = t.found.replace('{count}', results.length).replace('{query}', trimmed.replace(/</g, '&lt;'));

        let html = '';
        for (const { item } of results.slice(0, 50)) {
          let excerptText = item.excerpt || item.description || '';
          const content = item.content || '';
          const contentLower = content.toLowerCase();

          let firstMatch = -1;
          let matchLen = 0;
          for (const t of terms) {
            const idx = contentLower.indexOf(t);
            if (idx !== -1 && (firstMatch === -1 || idx < firstMatch)) {
              firstMatch = idx;
              matchLen = t.length;
            }
          }

          if (firstMatch !== -1) {
            const start = Math.max(0, firstMatch - 50);
            const end = Math.min(content.length, firstMatch + matchLen + 80);
            excerptText = (start > 0 ? '...' : '') + content.substring(start, end).trim() + (end < content.length ? '...' : '');
          }

          html += `
            <div style="border-bottom: 1px dashed var(--border, #eee); padding: 1.5rem 0;">
              <div style="font-size: 1.3rem; font-weight: bold; margin-bottom: 0.5rem;">
                <a href="${item.url}" style="color: var(--text, #333); text-decoration: none;">${highlight(item.title, terms)}</a>
              </div>
              <div style="color: var(--text-muted, #666); font-size: 0.95rem; line-height: 1.6;">
                ${highlight(excerptText, terms)}
              </div>
            </div>
          `;
        }
        resultsContainer.innerHTML = html;
      };

      input.addEventListener('input', (e) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => performSearch(e.target.value), 200);
      });

      input.addEventListener('focus', loadIndex, { once: true });

      const urlParams = new URLSearchParams(window.location.search);
      const initialQ = urlParams.get('q') || urlParams.get('query');
      if (initialQ) {
        input.value = initialQ;
        loadIndex().then(() => performSearch(initialQ));
      } else {
        setTimeout(loadIndex, 500);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCustomSearch);
    } else {
      initCustomSearch();
    }
    document.addEventListener('astro:page-load', initCustomSearch);
  </script>
</Layout>
