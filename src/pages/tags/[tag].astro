
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  const tagMap = new Map<string, { displayName: string; posts: typeof posts }>();
  for (const post of posts) {
    if (!post.data.tags) continue;
    for (const rawTag of post.data.tags) {
      const lower = rawTag.toLowerCase();
      if (!tagMap.has(lower)) {
        tagMap.set(lower, { displayName: rawTag, posts: [] });
      }
      const item = tagMap.get(lower)!;
      if (!item.posts.some(p => p.id === post.id)) {
        item.posts.push(post);
      }
    }
  }

  return Array.from(tagMap.entries()).map(([slug, { displayName, posts: filteredPosts }]) => ({
    params: { tag: slug },
    props: { posts: filteredPosts, displayName },
  }));
}

const { tag } = Astro.params;
const { posts, displayName = tag } = Astro.props;
---
<Layout title={`Tag: ${displayName}`}>
  <section class="post-list">
    <h2>Tag: {displayName}</h2>
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`}>
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">{new Date(post.data.pubDate).toLocaleDateString('en-US')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
	.post-list h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid #eee;
		padding-bottom: 1rem;
	}
	.post-list ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem;
		border-radius: 8px;
		text-decoration: none;
		color: #333;
		transition: background-color 0.2s ease;
		margin-bottom: 0.5rem;
	}
	.post-list li a:hover {
		background-color: #f5f5f5;
	}
	.post-title {
		font-size: 1.2rem;
		font-weight: 500;
	}
	.post-date {
		font-size: 0.9rem;
		color: #888;
		font-variant-numeric: tabular-nums;
	}
</style>
