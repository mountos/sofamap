
---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { categoriesTranslation } from '../../utils/i18n';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  const catMap = new Map<string, { displayName: string; posts: typeof posts }>();
  for (const post of posts) {
    if (!post.data.categories) continue;
    for (const rawCat of post.data.categories) {
      const lower = rawCat.toLowerCase();
      if (!catMap.has(lower)) {
        catMap.set(lower, { displayName: rawCat, posts: [] });
      }
      const item = catMap.get(lower)!;
      if (!item.posts.some(p => p.id === post.id)) {
        item.posts.push(post);
      }
    }
  }

  return Array.from(catMap.entries()).map(([slug, { displayName, posts: filteredPosts }]) => ({
    params: { category: slug },
    props: { posts: filteredPosts, displayName },
  }));
}

const { category } = Astro.params;
const { posts, displayName = category } = Astro.props;

// Determine category display name based on the posts' language
const firstPostLang = posts.length > 0 ? (posts[0].id.endsWith('.zh-TW.md') ? 'zh-TW' : (posts[0].id.endsWith('.ja.md') ? 'ja' : 'en')) : 'en';
const categoryDisplayName = (categoriesTranslation[firstPostLang] && categoriesTranslation[firstPostLang][displayName]) || displayName;
---
<Layout title={`Category: ${categoryDisplayName}`}>
  <section class="post-list">
    <h2>Category: {categoryDisplayName}</h2>
    <ul>
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id.replace(/\.mdx?$/, '')}/`}>
            <span class="post-title">{post.data.title}</span>
            <span class="post-date">{new Date(post.data.pubDate).toLocaleDateString('en-US')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
	.post-list h2 {
		font-size: 2rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid #eee;
		padding-bottom: 1rem;
	}
	.post-list ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.post-list li a {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem;
		border-radius: 8px;
		text-decoration: none;
		color: #333;
		transition: background-color 0.2s ease;
		margin-bottom: 0.5rem;
	}
	.post-list li a:hover {
		background-color: #f5f5f5;
	}
	.post-title {
		font-size: 1.2rem;
		font-weight: 500;
	}
	.post-date {
		font-size: 0.9rem;
		color: #888;
		font-variant-numeric: tabular-nums;
	}
</style>
